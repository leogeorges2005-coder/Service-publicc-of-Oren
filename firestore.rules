rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estWhitelliste() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/whitelist/$(request.auth.uid));
    }

    function estAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/whitelist/$(request.auth.uid)).data.admin == true;
    }

    // Registre public : nom, prénom, dates de naissance/décès.
    // Lecture libre pour tout le monde, écriture réservée aux coroners whitelistés.
    match /registre_public/{docId} {
      allow read: if true;
      allow write: if estWhitelliste();
    }

    // Dossiers complets (photos, lieu, position, dégâts, tatouages, cicatrices...).
    // Réservés en lecture et écriture aux coroners whitelistés.
    match /dossiers_coroner/{docId} {
      allow read, write: if estWhitelliste();
    }

    // Liste blanche : un document par coroner autorisé, dont l'ID est son UID Firebase Auth.
    // Chacun peut lire son propre statut ; seul un admin peut créer/modifier/supprimer des entrées.
    match /whitelist/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || estAdmin());
      allow write: if estAdmin();
    }

    // Identité choisie par chaque coroner (nom, prénom affichés dans ses dossiers).
    // Chacun ne peut modifier que son propre document ; un admin peut tous les lire (liste d'administration).
    match /coroners/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || estAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Demandes d'accès envoyées par un compte connecté mais pas encore whitelisté.
    // Chacun gère sa propre demande ; un admin peut toutes les lire/supprimer pour les traiter.
    match /demandes_acces/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || estAdmin());
    }
  }
}
